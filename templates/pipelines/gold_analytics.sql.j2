-- Gold analytics model: {{ tenant_id }}
-- Layer: gold_{{ tenant_id }} (per-tenant schema, analyst-facing)
-- Generated by: scaffold_pipelines handler
--
-- This schema is the analyst-facing layer for {{ tenant_id }}. Models here
-- are read-only and derive from Silver and Vault tables. They must not
-- contain MERGE or INSERT logic; use CREATE OR REPLACE VIEW or
-- CREATE OR REPLACE TABLE AS SELECT (CTAS) with a full refresh.
--
-- Incremental materialisation: where table size warrants it, use CTAS with
-- a date partition and a WHERE clause on event_timestamp. See the dbt model
-- config block below.

-- ── KPI summary (materialised daily) ─────────────────────────────────────────

CREATE OR REPLACE TABLE {{ catalog }}.{{ gold_schema }}.kpi_summary
USING DELTA
PARTITIONED BY (event_date)
TBLPROPERTIES (
    'delta.enableChangeDataFeed' = 'false',
    'quality.layer' = 'gold',
    'quality.refresh' = 'daily'
)
AS
SELECT
    DATE(event_timestamp)     AS event_date,
    event_type,
    status,
    COUNT(*)                  AS event_count,
    COUNT(DISTINCT reference_id) AS unique_references,
    MIN(event_timestamp)      AS first_event_ts,
    MAX(event_timestamp)      AS last_event_ts,
    current_timestamp()       AS refreshed_at
FROM {{ catalog }}.{{ silver_schema }}.events
WHERE tenant_id = '{{ tenant_id }}'
  -- TODO: adjust lookback window based on customer contract
  AND event_timestamp >= DATE_ADD(current_date(), -90)
GROUP BY DATE(event_timestamp), event_type, status;


-- ── Event detail view (no materialisation; always current) ───────────────────

CREATE OR REPLACE VIEW {{ catalog }}.{{ gold_schema }}.event_detail AS
SELECT
    event_id,
    event_type,
    event_timestamp,
    source_system,
    status,
    reference_id,
    created_at,
    last_updated_at
FROM {{ catalog }}.{{ silver_schema }}.events
WHERE tenant_id = '{{ tenant_id }}';


-- ── Cycle time (materialised daily) ──────────────────────────────────────────

CREATE OR REPLACE TABLE {{ catalog }}.{{ gold_schema }}.cycle_time
USING DELTA
TBLPROPERTIES ('quality.layer' = 'gold', 'quality.refresh' = 'daily')
AS
SELECT
    reference_id,
    MIN(event_timestamp)                              AS started_at,
    MAX(event_timestamp)                              AS completed_at,
    DATEDIFF(MAX(event_timestamp), MIN(event_timestamp)) AS cycle_days,
    COUNT(DISTINCT event_type)                        AS step_count
FROM {{ catalog }}.{{ silver_schema }}.events
WHERE tenant_id = '{{ tenant_id }}'
  AND status IN ('completed', 'approved', 'rejected')
GROUP BY reference_id;

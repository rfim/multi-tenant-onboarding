-- Silver MERGE: {{ tenant_id }}
-- Layer: silver (type-safe, deduplicated, MERGE logic)
-- Generated by: scaffold_pipelines handler
--
-- This model reads from bronze.raw_{{ tenant_id }}_events and produces
-- a cleaned, type-cast, deduplicated Silver table using a MERGE statement.
-- Change Data Feed on the Bronze table is the source for incremental runs.
--
-- Idempotency: the MERGE is keyed on (tenant_id, event_id). Re-running is safe.

MERGE INTO {{ catalog }}.{{ silver_schema }}.events AS target
USING (
    SELECT
        tenant_id,
        event_id,
        event_type,
        CAST(event_timestamp AS TIMESTAMP)  AS event_timestamp,
        source_system,
        -- TODO: add tenant-specific field extractions from payload JSON here
        -- Example: GET_JSON_OBJECT(payload, '$.workflow_id') AS workflow_id,
        GET_JSON_OBJECT(payload, '$.status')       AS status,
        GET_JSON_OBJECT(payload, '$.reference_id') AS reference_id,
        _ingested_at,
        _batch_id
    FROM {{ catalog }}.{{ bronze_schema }}.raw_{{ tenant_id }}_events
    WHERE tenant_id = '{{ tenant_id }}'
      -- CDF filter: in production this is replaced by a watermark on _commit_version
      AND _ingested_at > (
          SELECT COALESCE(MAX(last_updated_at), TIMESTAMP '2000-01-01')
          FROM {{ catalog }}.monitoring.silver_watermarks
          WHERE tenant_id = '{{ tenant_id }}'
            AND table_name = 'events'
      )
) AS source
ON target.tenant_id = source.tenant_id
   AND target.event_id = source.event_id
WHEN MATCHED AND source.status != target.status THEN
    UPDATE SET
        target.status       = source.status,
        target.last_updated_at = current_timestamp()
WHEN NOT MATCHED THEN
    INSERT (
        tenant_id, event_id, event_type, event_timestamp,
        source_system, status, reference_id,
        created_at, last_updated_at, _batch_id
    )
    VALUES (
        source.tenant_id, source.event_id, source.event_type,
        source.event_timestamp, source.source_system, source.status,
        source.reference_id,
        current_timestamp(), current_timestamp(), source._batch_id
    );

-- Update watermark
MERGE INTO {{ catalog }}.monitoring.silver_watermarks AS w
USING (SELECT '{{ tenant_id }}' AS tenant_id, 'events' AS table_name, current_timestamp() AS ts) AS s
ON w.tenant_id = s.tenant_id AND w.table_name = s.table_name
WHEN MATCHED THEN UPDATE SET w.last_updated_at = s.ts
WHEN NOT MATCHED THEN INSERT (tenant_id, table_name, last_updated_at) VALUES (s.tenant_id, s.table_name, s.ts);

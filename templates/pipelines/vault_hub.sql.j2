-- Data Vault 2.0: Hub and Satellite for {{ tenant_id }}
-- Layer: vault
-- Generated by: scaffold_pipelines handler
--
-- DV2 conventions used here:
--   Hub:       business key + hash key + load date + record source
--   Satellite: hash key + load date + hash diff + attributes
--   Link:      hash key + FK hub keys + load date + record source
--
-- Hash algorithm: SHA2-256 applied to uppercased, trimmed business keys.
-- All vault tables include tenant_id as a partition column.

-- Hub: core business entity
CREATE TABLE IF NOT EXISTS {{ catalog }}.{{ vault_schema }}.hub_{{ tenant_id }}_event (
    h_event_hk    BINARY     NOT NULL,   -- SHA2(UPPER(TRIM(event_id)))
    tenant_id     STRING     NOT NULL,
    event_id      STRING     NOT NULL,   -- business key
    load_dts      TIMESTAMP  NOT NULL,
    record_source STRING     NOT NULL
)
USING DELTA
PARTITIONED BY (tenant_id)
TBLPROPERTIES ('quality.layer' = 'vault', 'quality.dv_type' = 'hub');

-- Satellite: mutable attributes
CREATE TABLE IF NOT EXISTS {{ catalog }}.{{ vault_schema }}.sat_{{ tenant_id }}_event_detail (
    h_event_hk      BINARY     NOT NULL,
    load_dts        TIMESTAMP  NOT NULL,
    load_end_dts    TIMESTAMP,
    tenant_id       STRING     NOT NULL,
    hash_diff       BINARY     NOT NULL, -- SHA2 of all satellite attributes
    status          STRING,
    reference_id    STRING,
    event_type      STRING,
    -- TODO: add tenant-specific attributes identified by deviation_detector
    record_source   STRING     NOT NULL
)
USING DELTA
PARTITIONED BY (tenant_id)
TBLPROPERTIES ('quality.layer' = 'vault', 'quality.dv_type' = 'satellite');

-- Hub load: incremental from Silver
MERGE INTO {{ catalog }}.{{ vault_schema }}.hub_{{ tenant_id }}_event AS h
USING (
    SELECT DISTINCT
        SHA2(UPPER(TRIM(event_id)), 256) AS h_event_hk,
        '{{ tenant_id }}'                AS tenant_id,
        event_id,
        MIN(event_timestamp)             AS load_dts,
        'silver.events'                  AS record_source
    FROM {{ catalog }}.{{ silver_schema }}.events
    WHERE tenant_id = '{{ tenant_id }}'
    GROUP BY event_id
) AS s
ON h.h_event_hk = s.h_event_hk AND h.tenant_id = s.tenant_id
WHEN NOT MATCHED THEN
    INSERT (h_event_hk, tenant_id, event_id, load_dts, record_source)
    VALUES (s.h_event_hk, s.tenant_id, s.event_id, s.load_dts, s.record_source);

# Gold DQ contract: {{ tenant_id }}
# Layer: gold_{{ tenant_id }}
# Generated by: scaffold_quality handler
#
# Gold contracts are stricter than Bronze/Silver because they are the
# analyst-facing layer. Failures here are visible to the tenant directly.

expectation_suite_name: gold_{{ tenant_id }}_kpi_summary

meta:
  tenant_id: "{{ tenant_id }}"
  catalog: "{{ catalog }}"
  layer: gold
  generated_at: "{{ now_utc }}"
  contract_version: "1.0.0"

expectations:

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: event_date }
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: event_count }
    meta: { severity: sev1 }

  # event_count must be a positive integer
  - expectation_type: expect_column_values_to_be_between
    kwargs:
      column: event_count
      min_value: 0
    meta: { severity: sev1 }

  # No duplicate dates within a single event_type
  - expectation_type: expect_compound_columns_to_be_unique
    kwargs:
      column_list: [event_date, event_type, status]
    meta: { severity: sev1 }

  # Freshness: kpi_summary must have been refreshed today
  - expectation_type: expect_column_max_to_be_between
    kwargs:
      column: refreshed_at
      min_value: "{{ today }}"
      max_value: null
    meta:
      severity: sev1
      note: If this fails, the Gold refresh pipeline has not run today.

  # Completeness: the last 7 event_date values must be present
  # (i.e. no gap in the daily series)
  # Implemented as a custom dbt test in dbt/models/gold_{{ tenant_id }}/schema.yml
  # because GE cannot easily express date series continuity.
  # See: dbt test assert_no_date_gaps

  # Volume relative check — delegated to anomaly_detector
  - expectation_type: expect_table_row_count_to_be_between
    kwargs:
      min_value: 1
      max_value: null
    meta:
      severity: sev2
      anomaly_detector_threshold_pct: 30

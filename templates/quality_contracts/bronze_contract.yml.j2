# Bronze DQ contract: {{ tenant_id }}
# Layer: bronze
# Generated by: scaffold_quality handler
#
# These expectations apply to {{ catalog }}.bronze.raw_{{ tenant_id }}_events.
# They represent the minimum quality bar for raw ingested data. Do not tighten
# thresholds here without a corresponding change to the Silver contract.
#
# Expectation suite name: bronze_{{ tenant_id }}_events
# GE datasource: databricks_unity_catalog

expectation_suite_name: bronze_{{ tenant_id }}_events

meta:
  tenant_id: "{{ tenant_id }}"
  catalog: "{{ catalog }}"
  layer: bronze
  generated_at: "{{ now_utc }}"
  contract_version: "1.0.0"

expectations:

  # Completeness: key columns must be non-null
  - expectation_type: expect_column_values_to_not_be_null
    kwargs:
      column: tenant_id
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs:
      column: event_id
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs:
      column: event_timestamp
    meta: { severity: sev1 }

  # Tenant isolation: all rows must belong to this tenant
  - expectation_type: expect_column_values_to_be_in_set
    kwargs:
      column: tenant_id
      value_set: ["{{ tenant_id }}"]
    meta:
      severity: sev1
      note: >
        A violation here indicates an RLS misconfiguration or a data routing
        error. Escalate immediately to the Data Platform Lead.

  # Uniqueness: event_id must be unique within tenant
  - expectation_type: expect_column_values_to_be_unique
    kwargs:
      column: event_id
    meta: { severity: sev2 }

  # Recency: no rows older than 90 days should be ingested via the live pipeline
  - expectation_type: expect_column_values_to_be_between
    kwargs:
      column: event_timestamp
      min_value: "{{ lookback_start }}"   # rendered at runtime as NOW() - 90 days
      max_value: "{{ tomorrow }}"
    meta:
      severity: sev2
      note: Historical backfills are exempt; set skip_historical_backfill=true in the run config.

  # Volume: relative check — compare against 7-day rolling average
  # This expectation is evaluated by the anomaly_detector agent, not GE directly.
  # It is recorded here for documentation and threshold reference.
  - expectation_type: expect_table_row_count_to_be_between
    kwargs:
      min_value: 1
      max_value: null   # no hard upper bound; anomaly_detector handles relative checks
    meta:
      severity: sev2
      anomaly_detector_threshold_pct: 50

  # Schema stability
  - expectation_type: expect_table_columns_to_match_set
    kwargs:
      column_set:
        - tenant_id
        - event_id
        - event_type
        - event_timestamp
        - source_system
        - payload
        - _ingested_at
        - _source_file
        - _batch_id
      exact_match: false   # additional columns are permitted (pass-through)
    meta: { severity: sev2 }

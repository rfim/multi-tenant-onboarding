# Silver DQ contract: {{ tenant_id }}
# Layer: silver
# Generated by: scaffold_quality handler

expectation_suite_name: silver_{{ tenant_id }}_events

meta:
  tenant_id: "{{ tenant_id }}"
  catalog: "{{ catalog }}"
  layer: silver
  generated_at: "{{ now_utc }}"
  contract_version: "1.0.0"

expectations:

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: tenant_id }
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: event_id }
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: event_timestamp }
    meta: { severity: sev1 }

  - expectation_type: expect_column_values_to_not_be_null
    kwargs: { column: status }
    meta: { severity: sev2 }

  # Status values must be drawn from the known set
  - expectation_type: expect_column_values_to_be_in_set
    kwargs:
      column: status
      value_set:
        - pending
        - in_progress
        - completed
        - approved
        - rejected
        - cancelled
      # TODO: if deviation_detector found custom workflow states, add them here
    meta:
      severity: sev2
      note: >
        If the tenant uses custom workflow states, the deviation_detector agent
        will propose additions to this set via a PR.

  # Silver must not grow stale: last updated within 26 hours (daily + buffer)
  - expectation_type: expect_column_max_to_be_between
    kwargs:
      column: last_updated_at
      min_value: "{{ yesterday_minus_2h }}"
      max_value: null
    meta:
      severity: sev1
      note: A stale Silver table means the MERGE pipeline has not run successfully.

  # Referential check: every Silver event_id must exist in the Bronze table
  # This is enforced as a dbt test, not a GE expectation, to avoid cross-table scans.
  # See dbt/models/silver/{{ tenant_id }}/schema.yml for the dbt relationship test.

  # Uniqueness
  - expectation_type: expect_column_values_to_be_unique
    kwargs: { column: event_id }
    meta: { severity: sev1 }

  # No future-dated records after the MERGE
  - expectation_type: expect_column_values_to_be_between
    kwargs:
      column: event_timestamp
      min_value: null
      max_value: "{{ tomorrow }}"
    meta: { severity: sev2 }
